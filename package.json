{
  "name": "zznobzz-dsh-inline-charts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inline Chart.js charts and sandboxed HTML/JS widgets in chat, plus the render_chart agent tool.",
  "license": "MIT",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/index.js",
    "client/index.js",
    "client/client.chartjs.js",
    "client/vendor/chart.umd.js",
    "client/vendor/CHARTJS-LICENSE.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
